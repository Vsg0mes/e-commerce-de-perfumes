# Copie para .env e preencha TODOS os valores marcados com TROQUE_*.
# O `docker compose up` falha se algum obrigatório estiver faltando.
# Para gerar um segredo seguro:  openssl rand -hex 32

# ==============================
# PostgreSQL (obrigatório)
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=ecommerce

# ==============================
# Prisma / Backend
# ATENÇÃO: usa hostname Docker "postgres", NÃO localhost
# Para rodar fora do Docker: use localhost:5432
# (a senha deve ser a mesma de POSTGRES_PASSWORD)
# ==============================
DATABASE_URL=postgresql://postgres:TROQUE_POR_UMA_SENHA_FORTE@postgres:5432/ecommerce?schema=public

# ==============================
# JWT (obrigatório) — gere com: openssl rand -hex 32
# Em produção exige no mínimo 32 caracteres
# ==============================
JWT_SECRET=TROQUE_gere_com_openssl_rand_hex_32

# ==============================
# Admin inicial (usado pelo seed)
# Em produção o seed aborta sem ADMIN_EMAIL/ADMIN_PASSWORD.
# Em desenvolvimento, sem ADMIN_PASSWORD, uma senha aleatória é gerada e impressa uma vez.
# ==============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# ==============================
# Servidor
# ==============================
PORT=3333
NODE_ENV=development

# ==============================
# Stripe (obrigatório) — NUNCA COMMITE VALORES REAIS
# ==============================
STRIPE_SECRET_KEY=sk_test_TROQUE
STRIPE_WEBHOOK_SECRET=whsec_TROQUE
# Chave PÚBLICA (pk_...), segura para o navegador
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_TROQUE

# ==============================
# URLs (apontam para o Nginx)
# ==============================
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# ==============================
# Frontend (Vite) — via Nginx
# ==============================
VITE_API_URL=/api
