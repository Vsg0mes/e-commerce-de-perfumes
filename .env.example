# ==============================
# PostgreSQL
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# ==============================
# Prisma / Backend
# ATENÇÃO: usa hostname Docker "postgres", NÃO localhost
# Para rodar fora do Docker: use localhost:5432
# ==============================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce?schema=public

# ==============================
# JWT — TROQUE POR UM SECRET SEGURO EM PRODUÇÃO
# ==============================
JWT_SECRET=super_secret_jwt_key_here

# ==============================
# Servidor
# ==============================
PORT=3333

# ==============================
# Stripe — NUNCA COMMITE VALORES REAIS
# ==============================
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# ==============================
# URLs (apontam para o Nginx)
# ==============================
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# ==============================
# Frontend (Vite) — via Nginx
# ==============================
VITE_API_URL=/api
