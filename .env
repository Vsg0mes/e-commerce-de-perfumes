# ==============================
# PostgreSQL
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# ==============================
# Prisma / Backend
# ATENÇÃO: usa hostname Docker "postgres", NÃO localhost
# ==============================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce?schema=public

# ==============================
# JWT
# ==============================
JWT_SECRET=super_secret_jwt_key_here

# ==============================
# Servidor
# ==============================
PORT=3333

# ==============================
# Mercado Pago
# ==============================
PAYMENT_ACCESS_TOKEN=YOUR_MERCADO_PAGO_ACCESS_TOKEN
PAYMENT_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ==============================
# URLs (apontam para o Nginx)
# ==============================
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# ==============================
# Frontend (Vite) — via Nginx
# ==============================
VITE_API_URL=/api
